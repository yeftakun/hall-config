<Window x:Class="HallConfig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HallConfig — Gamepad Signal Processor"
        Icon="pack://application:,,,/Assets/icon.ico"
        Width="1080" Height="680" MinWidth="880" MinHeight="560"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#E6EDF3">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ── Toggle Switch ──────────────────────────────────────────── -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="52"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="13"
                                Background="#30363D" Width="52" Height="26">
                            <Ellipse x:Name="Thumb" Width="20" Height="20"
                                     Fill="White" HorizontalAlignment="Left"
                                     Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background"          Value="#238636"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin"              Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Thumb" Property="Fill"    Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Slim Slider ─────────────────────────────────────────────── -->
        <Style x:Key="DarkSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#388BFD"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#21262D"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Cursor="Hand">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#388BFD" BlurRadius="6"
                                                                          ShadowDepth="0" Opacity="0.7"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ─────────────────────────────────────────── -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="14,8"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost Button ───────────────────────────────────────────── -->
        <Style x:Key="GhostButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background"  Value="#21262D"/>
            <Setter Property="FontWeight"  Value="Normal"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>

        <!-- ── Custom Meter Bar ───────────────────────────────────────── -->
        <Style x:Key="MeterBarStyle" TargetType="ProgressBar">
            <Setter Property="Height"          Value="12"/>
            <Setter Property="Background"      Value="#21262D"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Maximum"         Value="1"/>
            <Setter Property="Minimum"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}" ClipToBounds="True">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="4"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section label ──────────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#8B949E"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,12,0,4"/>
        </Style>

        <!-- ── Separator ──────────────────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Margin"     Value="0,4"/>
        </Style>

    </Window.Resources>

    <!-- ── Root grid ─────────────────────────────────────────────────────── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ LEFT PANEL — Tuning & Controls ═══════════════ -->
        <Border Grid.Column="0" BorderBrush="#21262D" BorderThickness="0,0,1,0" Background="#0D1117">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,20,20,16">

                    <!-- App title -->
                    <TextBlock Text="HALLCONFIG"
                               FontSize="18" FontWeight="Bold" Foreground="#58A6FF"/>
                    <TextBlock Text="Gamepad Signal Processor"
                               FontSize="11" Foreground="#8B949E" Margin="0,2,0,0"/>
                    <Separator Margin="0,14,0,10"/>

                    <!-- Output Mode Selector -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="OUTPUT EMULATION MODE" FontSize="9" FontWeight="Bold" Foreground="#58A6FF"/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Xbox 360 Mode Button -->
                                <Button Grid.Column="0" Command="{Binding SetXbox360ModeCommand}"
                                        Height="30" Padding="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeBorder" CornerRadius="4" Background="#21262D"
                                                    BorderBrush="#30363D" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🎮" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Xbox 360" FontSize="11" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsXbox360Mode}" Value="True">
                                                    <Setter TargetName="ModeBorder" Property="Background" Value="#1F6FEB"/>
                                                    <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#388BFD"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- vJoy Mode Button -->
                                <Button Grid.Column="2" Command="{Binding SetVJoyModeCommand}"
                                        Height="30" Padding="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeBorder" CornerRadius="4" Background="#21262D"
                                                    BorderBrush="#30363D" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🕹️" FontSize="11" Margin="0,0,4,0"/>
                                                    <TextBlock Text="vJoy" FontSize="11" FontWeight="SemiBold" Foreground="#C9D1D9"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsVJoyMode}" Value="True">
                                                    <Setter TargetName="ModeBorder" Property="Background" Value="#1F6FEB"/>
                                                    <Setter TargetName="ModeBorder" Property="BorderBrush" Value="#388BFD"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding OutputModeDescription}" FontSize="9.5" Foreground="#8B949E"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Axis Header Card -->
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="CONFIGURING AXIS" FontSize="9" FontWeight="Bold" Foreground="#58A6FF"/>
                            <TextBlock Text="{Binding SelectedAxisTitle}" FontSize="15" FontWeight="Bold"
                                       Foreground="#E6EDF3" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding SelectedAxisSubtitle}" FontSize="11"
                                       Foreground="#8B949E" Margin="0,2,0,0"/>
                            <TextBlock Text="💡 Click any axis card on the right to switch"
                                       FontSize="10" Foreground="#6E7681" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Separator Margin="0,2,0,6"/>

                    <!-- Smoothing -->
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SMOOTHING" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Text="Exponential Moving Average"
                                       FontSize="10" Foreground="#6E7681"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SmoothingEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Grid IsEnabled="{Binding SmoothingEnabled}" Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Alpha" Grid.Column="0"
                                   FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="#58A6FF" FontSize="12"
                                   Text="{Binding Alpha, StringFormat=F2}" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Style="{StaticResource DarkSliderStyle}"
                            IsEnabled="{Binding SmoothingEnabled}"
                            Minimum="0.05" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"
                            Value="{Binding Alpha, Mode=TwoWay}"
                            Margin="0,4,0,12"/>
                    <Separator/>

                    <!-- Hysteresis -->
                    <Grid Margin="0,6,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="HYSTERESIS" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Text="Schmitt Trigger Deadzone"
                                       FontSize="10" Foreground="#6E7681"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding HysteresisEnabled, Mode=TwoWay}"/>
                    </Grid>

                    <Grid IsEnabled="{Binding HysteresisEnabled}" Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Threshold Up ↑" Grid.Column="0"
                                   FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="#FFA657" FontSize="12"
                                   Text="{Binding ThresholdUp, StringFormat=F2}" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Style="{StaticResource DarkSliderStyle}"
                            IsEnabled="{Binding HysteresisEnabled}"
                            Minimum="0.01" Maximum="0.99" SmallChange="0.01" LargeChange="0.05"
                            Value="{Binding ThresholdUp, Mode=TwoWay}"
                            Margin="0,4,0,10"/>

                    <Grid IsEnabled="{Binding HysteresisEnabled}" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Threshold Down ↓" Grid.Column="0"
                                   FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Foreground="#FFA657" FontSize="12"
                                   Text="{Binding ThresholdDown, StringFormat=F2}" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider Style="{StaticResource DarkSliderStyle}"
                            IsEnabled="{Binding HysteresisEnabled}"
                            Minimum="0.01" Maximum="0.99" SmallChange="0.01" LargeChange="0.05"
                            Value="{Binding ThresholdDown, Mode=TwoWay}"
                            Margin="0,4,0,12"/>
                    <Separator/>

                    <!-- Vibration Feedback -->
                    <Grid Margin="0,6,0,4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRTVibrationToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowLTVibrationToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="VIBRATION FEEDBACK" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock Text="Physical Trigger Rumble Motor" FontSize="10" Foreground="#6E7681" Margin="0,0,0,8"/>
                            <TextBlock Text="⚠️ Controller hardware doesn't support vibration" FontSize="10" Foreground="#FFA657" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsControllerConnected}" Value="True" />
                                                    <Condition Binding="{Binding IsVibrationSupported}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Toggles -->
                        <Grid Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding IsVibrationSupported}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- RT -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable RT Vibration" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center" Visibility="{Binding ShowRTVibrationToggle, Converter={StaticResource BoolToVis}}"/>
                            <ToggleButton Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding RTVibrationEnabled, Mode=TwoWay}" Visibility="{Binding ShowRTVibrationToggle, Converter={StaticResource BoolToVis}}"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" SelectedIndex="{Binding RTVibrationMotorIndex}" Margin="0,8,0,0" Visibility="{Binding ShowRTVibrationToggle, Converter={StaticResource BoolToVis}}">
                                <ComboBoxItem Content="Low Freq (Left Motor)"/>
                                <ComboBoxItem Content="High Freq (Right Motor)"/>
                            </ComboBox>
                            
                            <!-- LT -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Enable LT Vibration" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center" Visibility="{Binding ShowLTVibrationToggle, Converter={StaticResource BoolToVis}}"/>
                            <ToggleButton Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LTVibrationEnabled, Mode=TwoWay}" Visibility="{Binding ShowLTVibrationToggle, Converter={StaticResource BoolToVis}}"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" SelectedIndex="{Binding LTVibrationMotorIndex}" Margin="0,8,0,0" Visibility="{Binding ShowLTVibrationToggle, Converter={StaticResource BoolToVis}}">
                                <ComboBoxItem Content="Low Freq (Left Motor)"/>
                                <ComboBoxItem Content="High Freq (Right Motor)"/>
                            </ComboBox>
                        </Grid>
                        
                        <!-- Max Intensity -->
                        <Grid Grid.Row="2" IsEnabled="{Binding IsVibrationSupported}" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max Intensity" Grid.Column="0" FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Foreground="#58A6FF" FontSize="12" Text="{Binding MaxVibrationPercent, StringFormat={}{0}%}" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider Grid.Row="1" Style="{StaticResource DarkSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding MaxVibrationPercent, Mode=TwoWay}" Margin="0,4,0,0"/>
                        </Grid>
                    </Grid>
                    
                    <Separator>
                        <Separator.Style>
                            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRTVibrationToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowLTVibrationToggle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Separator.Style>
                    </Separator>

                    <!-- Save / Load -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="💾  Save"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SaveConfigCommand}"/>
                        <Button Grid.Column="2" Content="📂  Load"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding LoadConfigCommand}"/>
                    </Grid>

                    <!-- Status message -->
                    <Border Background="#161B22" CornerRadius="6" Padding="10,6" Margin="0,12,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══════════════ RIGHT PANEL — 4 Axis Cards + Status ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" Background="#161B22" Padding="16,0" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Controller status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F85149"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsControllerConnected}" Value="True">
                                            <Setter Property="Fill" Value="#3FB950"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ControllerStatus}"
                                   FontSize="12" Foreground="#C9D1D9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Central Hint -->
                    <TextBlock Grid.Column="1" Text="Click any Axis Card to select for tuning &amp; output routing"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Foreground="#6E7681"/>

                    <!-- Rate & About -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RATE: " FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PipelineRateText}"
                                   FontSize="12" FontWeight="Bold" Foreground="#58A6FF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="ℹ About" Click="AboutButton_Click" Height="24" Padding="8,0"
                                Background="#21262D" Foreground="#8B949E" BorderThickness="1" BorderBrush="#30363D" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2x2 Interactive Axis Cards Area -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding AllCards}" Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clickable Card via styled Button -->
                        <Button Command="{Binding SelectCommand}" Margin="6" Cursor="Hand"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder" CornerRadius="8" Background="#161B22"
                                            BorderBrush="#21262D" BorderThickness="2" Padding="16,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 1. Header: Name, Tag, & State -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Short Badge (RT, LT, LX, LY) -->
                                                <Border Grid.Column="0" CornerRadius="4" Background="#21262D"
                                                        Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center" x:Name="ShortBadge">
                                                    <TextBlock Text="{Binding ShortName}" FontWeight="Bold" FontSize="13" Foreground="#58A6FF"/>
                                                </Border>

                                                <!-- Titles -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="#E6EDF3"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8B949E" Margin="0,1,0,0"/>
                                                </StackPanel>

                                                <!-- Selection & Activity Badges -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Triggered/Active badge -->
                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#21262D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="#0D3321"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="IDLE"/>
                                                                    <Setter Property="Foreground" Value="#6E7681"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Text" Value="ACTIVE"/>
                                                                            <Setter Property="Foreground" Value="#3FB950"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Selected / Target Badge -->
                                                    <Border x:Name="SelectedTag" CornerRadius="4" Padding="8,3"
                                                            Background="#1F6FEB" Visibility="Collapsed">
                                                        <TextBlock Text="{Binding DataContext.TargetOutputBadgeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2. RAW Level Meter -->
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,6">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="RAW INPUT" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                    <TextBlock HorizontalAlignment="Right" Foreground="#58A6FF"
                                                               FontSize="15" FontWeight="Bold"
                                                               Text="{Binding RawValue, StringFormat=F3}"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource MeterBarStyle}" Foreground="#388BFD"
                                                             Value="{Binding RawValue, Mode=OneWay}"/>
                                            </StackPanel>

                                            <Separator Grid.Row="2" Background="#21262D" Margin="0,2,0,6"/>

                                            <!-- 3. OUTPUT Level Meter -->
                                            <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="PROCESSED OUTPUT" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E"/>
                                                    <TextBlock HorizontalAlignment="Right" Foreground="#FFA657"
                                                               FontSize="15" FontWeight="Bold"
                                                               Text="{Binding ProcessedValue, StringFormat=F3}"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource MeterBarStyle}" Foreground="#F0883E"
                                                             Value="{Binding ProcessedValue, Mode=OneWay}"/>
                                            </StackPanel>

                                            <!-- 4. Footer: Config Summary Chip -->
                                            <Border Grid.Row="4" Background="#0D1117" CornerRadius="4" Padding="8,4" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ConfigSummary}" FontSize="10" Foreground="#8B949E"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Visual Triggers -->
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#484F58"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#388BFD"/>
                                            <Setter TargetName="CardBorder" Property="Background" Value="#121D2F"/>
                                            <Setter TargetName="SelectedTag" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="ShortBadge" Property="Background" Value="#1F6FEB"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Bottom Start / Stop Pipeline button -->
            <Border Grid.Row="2" Background="#0D1117" Padding="16,8" BorderBrush="#21262D" BorderThickness="0,1,0,0">
                <Button Command="{Binding TogglePipelineCommand}"
                        Content="{Binding PipelineButtonText}"
                        FontSize="14" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background" Value="#166534"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPipelineRunning}" Value="True">
                                    <Setter Property="Background" Value="#6E1313"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>
        </Grid>
    </Grid>
</Window>
