<Window x:Class="HallConfig.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About HallConfig"
        Height="410" Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0D1117"
        Foreground="#E6EDF3"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/icon.ico"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content Area: Centered Logo, Branding & Tagline -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- App Logo Visual -->
            <Image Source="pack://application:,,,/Assets/icon.png" Width="72" Height="72" Margin="0,0,0,12"
                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>

            <!-- App Title & Version -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="HallConfig" FontSize="22" FontWeight="Bold" Foreground="#00D2FF"/>
                <TextBlock Text="v1.2.0" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
            </StackPanel>

            <!-- Catchy Tagline -->
            <TextBlock Text="Smoother Inputs. Cleaner Trailbraking."
                       FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0,0,0,3" TextAlignment="Center"/>

            <!-- Technical Description -->
            <TextBlock Text="Hall-effect signal conditioning for gamepad triggers &amp; sticks"
                       FontSize="11" Foreground="#8B949E"
                       HorizontalAlignment="Center" Margin="0,0,0,14" TextAlignment="Center"/>

            <!-- Info Box: Target & License -->
            <Border Background="#161B22" BorderBrush="#21262D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8" Width="360">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="License" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock Text="MIT License" FontSize="11" FontWeight="Medium" Foreground="#C9D1D9" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Target Engines" FontSize="11" Foreground="#8B949E"/>
                        <TextBlock Text="ViGEm XInput • vJoy DirectInput" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer Area: Subtle Credits, GitHub Link, and Close Button -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Subtle credit & GitHub repo hyperlink -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="10" Foreground="#484F58" Margin="0,0,0,2">
                    made by <Run Foreground="#6E7681">Yefta Asyel</Run>
                </TextBlock>
                <TextBlock FontSize="10">
                    <Hyperlink NavigateUri="https://github.com/yeftakun/hall-config" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="#58A6FF" TextDecorations="None">
                        github.com/yeftakun/hall-config
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="1" Content="Close" Width="72" Height="28" Click="CloseButton_Click"
                    Background="#21262D" Foreground="#C9D1D9" FontWeight="Medium" FontSize="12"
                    BorderThickness="1" BorderBrush="#30363D" Cursor="Hand" VerticalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>
